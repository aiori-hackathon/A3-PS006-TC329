# Dockerfile for PS-006 Physical Lab Replicas
FROM node:22-alpine

WORKDIR /app

# Copy PKI certificates and replica service code
COPY pki/ ./pki/
COPY mini-services/replica/ ./mini-services/replica/

WORKDIR /app/mini-services/replica

EXPOSE 8443 8444

ENV NODE_ENV=production
ENV HTTPS_ENABLED=true

CMD ["node", "server.mjs"]
