# INTERLOCK (PS-006) Environment Configuration Template
# Copy to .env and configure values for your environment.

# Database URL for SQLite (relative path from prisma/ schema or absolute path)
DATABASE_URL="file:../db/custom.db"

# Admin API Key for protected mutation routes
# REQUIRED in production mode (NODE_ENV=production)
ADMIN_API_KEY="replace-with-a-secure-random-secret"

# Realtime Socket.IO Bridge
REALTIME_PORT=3033
REALTIME_URL="http://127.0.0.1:3033/publish"

# Realtime Token for server-to-server bridge authentication
# REQUIRED in production mode (NODE_ENV=production)
REALTIME_TOKEN="replace-with-a-secure-random-secret"

# Allowed browser origins for Socket.IO (comma-separated, or * for all in dev)
ALLOWED_ORIGINS="*"

# Session signing secret for HMAC-SHA-256 session tokens (min 32 chars)
# REQUIRED in production mode (NODE_ENV=production)
SESSION_SECRET="replace-with-a-secure-random-32-char-secret"

# Audit Log Cryptographic Algorithm (optional)
# When set to a string >= 32 chars, audit logs are signed with v2 HMAC-SHA-256
# When unset, v1 standard SHA-256 hash chaining is used
AUDIT_HMAC_KEY=""

# Demonstration mode: set to "true" to enable /api/audit/tamper and /api/audit/restore
# Leave empty or "false" in production
ALLOW_TAMPER_DEMO="false"

# Set to "production" when deploying
NODE_ENV="development"
